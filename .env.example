# Copy to .env and fill in. NEVER commit the real .env.

# Server酱 (sctp... = Server酱³ / SCT... = Turbo)
SERVERCHAN_KEY=

# 企业微信自建应用
# 调用方 IP 必须加入「企业可信IP」，否则 errcode=60020
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=

# 中继的措辞生成
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 服务器
ARK_SSH_HOST=            # 服务器 Tailscale IP
ARK_SSH_USER=Administrator
