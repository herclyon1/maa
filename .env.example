# Copy to .env and fill in. NEVER commit the real .env.

# Server酱 (sctp... = Server酱³ / SCT... = Turbo)
SERVERCHAN_KEY=

# 企业微信自建应用
# 调用方 IP 必须加入「企业可信IP」，否则 errcode=60020。
# 家宽 IP 会变，所以这条通道随时可能失效——别让它当唯一通道。
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=

# 企业微信群机器人（推荐给 IP 会变的机器）
# webhook 没有可信 IP 限制，任何机器都能发。URL 自带 key，整条都是密钥。
# 取得方式：企业微信 → 任意群 → 右上角「…」→ 群机器人 → 添加 → 复制 Webhook 地址
WECOM_BOT_URL=

# 中继的措辞生成
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 服务器
ARK_SSH_HOST=            # 服务器 Tailscale IP
ARK_SSH_USER=Administrator
