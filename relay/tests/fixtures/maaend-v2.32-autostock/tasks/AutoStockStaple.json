{
    // excerpt of MaaEnd v2.32.0 assets/tasks/AutoStockStaple.json
    "task": [
        {
            "name": "AutoStockStaple",
            "label": "$task.AutoStockStaple.label",
            "entry": "AutoStockStapleSchedule",
            "description": "$task.AutoStockStaple.description",
            "group": [
                "regional_development"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "AutoStockReserveWuling"
            ]
        }
    ],
    "option": {
        "AutoStockReserveWuling": {
            "type": "input",
            "label": "$task.AutoStockStaple.option.AutoStockReserveWuling.label",
            "description": "$task.AutoStockStaple.option.AutoStockReserveWuling.description",
            "inputs": [
                {
                    "name": "ReserveWuling",
                    "label": "$task.AutoStockStaple.option.AutoStockReserveWuling.inputs.ReserveWuling.label",
                    "description": "$task.AutoStockStaple.option.AutoStockReserveWuling.inputs.ReserveWuling.description",
                    "default": "240000",
                    "pipeline_type": "int",
                    "verify": "^(?:[2-9][4-9]\\d{4}|[3-9]\\d{5}|[1-9]\\d{6,})$",
                    "pattern_msg": "$task.AutoStockStaple.option.AutoStockReserveWuling.inputs.ReserveWuling.pattern_msg"
                }
            ],
            "pipeline_override": {
                "AutoStockTargetCompareWuling": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{ReserveWuling}>{AutoStockCurrentStockBill}"
                            }
                        }
                    }
                }
            }
        }
    },
}
